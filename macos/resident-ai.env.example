# Optional resident intelligence. Copy to .local/resident-ai.env; launch.sh
# exports that ignored private file automatically. Never commit real keys.
# Empty keys disable paid requests; grounded game answers still work locally.

# Full HTTPS endpoint implementing the chat-completions JSON contract.
# Set the provider's current prices before enabling chat; zero prices disable it.
RESIDENT_CHAT_ENDPOINT=''
RESIDENT_CHAT_API_KEY=''
RESIDENT_CHAT_MODEL=''
RESIDENT_CHAT_INPUT_USD_PER_MILLION=0
RESIDENT_CHAT_OUTPUT_USD_PER_MILLION=0

# TypeSafe Jev returns one of the controller's allowed decisions, never prose.
RESIDENT_JEV_ENDPOINT='https://api.typesafe.ai/v1/systemone'
RESIDENT_JEV_API_KEY=''
RESIDENT_JEV_MODEL='jev-1.14.0'
RESIDENT_JEV_INPUT_USD_PER_MILLION=0.042

# Shared spending/call ceiling per server process, resetting at midnight UTC.
# Reservations use a conservative input bound; missing usage or failed requests
# retain their reservation. Provider prices must match the configured rates.
RESIDENT_AI_DAILY_USD=1
RESIDENT_AI_DAILY_CALLS=5000
RESIDENT_AI_INTERVAL_MS=2500
RESIDENT_AI_TIMEOUT_MS=5000
